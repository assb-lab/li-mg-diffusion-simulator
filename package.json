{
  "name": "li-mg-diffusion-simulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev apps/web",
    "build": "vp check && vp build apps/web",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "check": "vp check && vp test run --coverage",
    "wasm:build": "wasm-pack build packages/diffusion-core --release --target bundler --out-dir pkg",
    "binary:build:apple-silicon": "./scripts/build-binary-apple-silicon.sh",
    "binary:build:windows-x64": "./scripts/build-binary-windows-x64.sh",
    "binary:test": "cd apps/web && go test ./staticserver/",
    "prepare": "vp config --hooks --hooks-dir .vite-hooks --no-agent"
  },
  "devDependencies": {
    "@li-mg/shared": "workspace:*",
    "@li-mg/ui": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plugin-wasm": "^3.6.0",
    "vite-plus": "1.5.0",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.16.1"
}
