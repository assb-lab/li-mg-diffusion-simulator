{
  "name": "li-mg-diffusion-simulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint apps packages tests vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm fmt:check && pnpm lint && pnpm test:coverage",
    "wasm:build": "wasm-pack build packages/diffusion-core --release --target bundler --out-dir pkg",
    "binary:build:apple-silicon": "./scripts/build-binary-apple-silicon.sh",
    "binary:build:windows-x64": "./scripts/build-binary-windows-x64.sh",
    "binary:test": "cd apps/web && go test ./staticserver/"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "esbuild": "^0.27.1",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2",
    "vite": "^8.0.16",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vite-plus": "latest",
    "vitest": "4.1.8"
  },
  "packageManager": "pnpm@11.5.3"
}
